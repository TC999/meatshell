<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX (v3) installer definition for meatshell, driven by `cargo wix`.

  cargo-wix injects these preprocessor variables:
    $(var.Version)            crate version from Cargo.toml
    $(var.CargoTargetBinDir)  e.g. target\x86_64-pc-windows-msvc\release

  The `WixUI_InstallDir` UI (bottom) gives the user a "Browse..." page. AppSearch
  restores the previous location before that page is shown, including v0.6.5
  installations whose ARP InstallLocation value was left blank.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
        Id="*"
        Name="meatshell"
        UpgradeCode="6E8F2A1B-3C4D-4E5F-9A0B-1C2D3E4F5A6B"
        Manufacturer="meatshell contributors"
        Language="1033"
        Codepage="65001"
        Version="$(var.Version)">

        <Package Id="*"
            Keywords="Installer"
            Description="meatshell - lightweight Rust + Slint SSH/terminal client"
            Manufacturer="meatshell contributors"
            InstallerVersion="450"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            SummaryCodepage="936"/>

        <!-- Replace an older install in place instead of erroring out. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of meatshell is already installed. Setup will now exit."/>

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1"/>
        <Property Id="DiskPrompt" Value="meatshell Installation"/>

        <!--
          A stdio MCP client can keep `meatshell.exe mcp serve` alive after the
          GUI has closed. Windows cannot replace a running executable during a
          major upgrade, so give the user an explicit Abort/Retry/Ignore prompt.
          Retry lets them close the MCP host cleanly; Ignore closes ordinary GUI
          windows first and, after the timeout, terminates a windowless MCP copy.
          This is intentionally upgrade-only: a first install has no old binary.
        -->
        <util:CloseApplication
            Id="CloseRunningMeatShellForUpgrade"
            Target="meatshell.exe"
            Description="MeatShell or its MCP server is still running. Close MeatShell and any MCP client using it, then click Retry. Choose Ignore to close it automatically."
            PromptToContinue="yes"
            CloseMessage="yes"
            ElevatedCloseMessage="yes"
            Timeout="10"
            TerminateProcess="0"
            RebootPrompt="no">WIX_UPGRADE_DETECTED</util:CloseApplication>

        <Icon Id="ProductICO" SourceFile="assets\meatshell.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>

        <!--
          Preserve a custom install location across major upgrades (#293).
          New packages write Software\meatshell\InstallDir below. The component
          search is the migration fallback for v0.6.5-v0.6.7, which did not
          persist either that value or ARPINSTALLLOCATION. MainExecutable's
          generated component GUID in those packages was stable and is now
          pinned explicitly below.
        -->
        <Property Id="APPLICATIONFOLDER" Secure="yes">
            <RegistrySearch Id="PreviousInstallDirRegistry"
                Root="HKLM"
                Key="Software\meatshell"
                Name="InstallDir"
                Type="directory"
                Win64="yes"/>
            <ComponentSearch Id="PreviousMainExecutable"
                Guid="{ECB1F8D7-7CC7-5A8A-A7CC-56A267A502DC}"
                Type="file">
                <DirectorySearch Id="PreviousMainExecutableDirectory"
                    AssignToProperty="yes"/>
            </ComponentSearch>
        </Property>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <!-- Default path; the InstallDir UI lets the user change it. -->
                <Directory Id="APPLICATIONFOLDER" Name="meatshell">
                    <Component Id="MainExecutable"
                               Guid="{ECB1F8D7-7CC7-5A8A-A7CC-56A267A502DC}">
                        <File Id="meatshellEXE"
                              Name="meatshell.exe"
                              Source="$(var.CargoTargetBinDir)\meatshell.exe"
                              KeyPath="yes"/>
                    </Component>
                    <Component Id="ThirdPartyNotices" Guid="*">
                        <File Id="thirdPartyNoticesFile"
                              Name="THIRD_PARTY_NOTICES.md"
                              Source="THIRD_PARTY_NOTICES.md"
                              KeyPath="yes"/>
                    </Component>
                    <Component Id="InstallLocationRegistry"
                               Guid="{E6877B59-AD5C-4CA3-A1F5-8F8E0CC6CC53}"
                               Win64="yes">
                        <RegistryValue Root="HKLM"
                            Key="Software\meatshell"
                            Name="InstallDir"
                            Type="string"
                            Value="[APPLICATIONFOLDER]"
                            KeyPath="yes"/>
                    </Component>

                    <!--
                      Explorer context-menu verb "在此处打开 meatshell":
                      registered under HKCR so it survives across installs.
                      WiX needs one component per registry root, so three
                      separate components below cover folder, empty-canvas
                      and file right-clicks.  Uninstall removes the whole
                      subtree cleanly (Remove="uninstall" on the default
                      value).  We install per-machine so the entries are
                      visible to all users.  See src/app/registry_menu.rs
                      for the equivalent runtime path.
                    -->
                    <Component Id="ContextMenuDirectory"
                               Guid="{B1D6F4F9-2D1C-4E7A-8B9F-3A0D5C6E7F8A}"
                               Win64="yes">
                        <RegistryKey Root="HKCR"
                            Key="Directory\shell\meatshell"
                            ForceDeleteOnUninstall="yes">
                            <RegistryValue Type="string"
                                Value="在此处打开 meatshell"
                                KeyPath="yes"/>
                            <RegistryValue Type="string"
                                Name="command"
                                Value='"[APPLICATIONFOLDER]meatshell.exe" --new-window --dir "%%V"'/>
                        </RegistryKey>
                    </Component>
                    <Component Id="ContextMenuDirectoryBackground"
                               Guid="{C2E7A5A0-3E2D-5F8B-9C0A-4B1E6D7F8A9B}"
                               Win64="yes">
                        <RegistryKey Root="HKCR"
                            Key="Directory\Background\shell\meatshell"
                            ForceDeleteOnUninstall="yes">
                            <RegistryValue Type="string"
                                Value="在此处打开 meatshell"
                                KeyPath="yes"/>
                            <RegistryValue Type="string"
                                Name="command"
                                Value='"[APPLICATIONFOLDER]meatshell.exe" --new-window --dir "%%V"'/>
                        </RegistryKey>
                    </Component>
                    <Component Id="ContextMenuFile"
                               Guid="{D3F8B6B1-4F3E-6A9C-0D1B-5C2F7E8A9C0D}"
                               Win64="yes">
                        <RegistryKey Root="HKCR"
                            Key="*\shell\meatshell"
                            ForceDeleteOnUninstall="yes">
                            <RegistryValue Type="string"
                                Value="在此处打开 meatshell"
                                KeyPath="yes"/>
                            <RegistryValue Type="string"
                                Name="command"
                                Value='"[APPLICATIONFOLDER]meatshell.exe" --new-window --dir "%%V"'/>
                        </RegistryKey>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Component Id="ApplicationShortcut" Guid="*">
                    <Shortcut Id="StartMenuShortcut"
                        Name="meatshell"
                        Description="Lightweight SSH/terminal client"
                        Target="[APPLICATIONFOLDER]meatshell.exe"
                        WorkingDirectory="APPLICATIONFOLDER"
                        Icon="ProductICO"/>
                    <RemoveFolder Id="CleanUpShortCut" On="uninstall"/>
                    <RegistryValue Root="HKCU"
                        Key="Software\meatshell"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="DesktopShortcut"
                           Guid="{A034B952-E060-47C3-8D04-FCA147FBE3E5}">
                    <Shortcut Id="DesktopShortcutLink"
                        Name="meatshell"
                        Description="Lightweight SSH/terminal client"
                        Target="[APPLICATIONFOLDER]meatshell.exe"
                        WorkingDirectory="APPLICATIONFOLDER"
                        Icon="ProductICO"/>
                    <RegistryValue Root="HKCU"
                        Key="Software\meatshell"
                        Name="desktopShortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id="MainProgram" Title="meatshell" Level="1">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ThirdPartyNotices"/>
            <ComponentRef Id="InstallLocationRegistry"/>
            <ComponentRef Id="ContextMenuDirectory"/>
            <ComponentRef Id="ContextMenuDirectoryBackground"/>
            <ComponentRef Id="ContextMenuFile"/>
            <ComponentRef Id="ApplicationShortcut"/>
            <ComponentRef Id="DesktopShortcut"/>
        </Feature>

        <!-- Populate Programs and Features -> InstallLocation as well. -->
        <CustomAction Id="SetARPInstallLocation"
            Property="ARPINSTALLLOCATION"
            Value="[APPLICATIONFOLDER]"
            Execute="immediate"/>
        <InstallExecuteSequence>
            <Custom Action="SetARPInstallLocation" After="CostFinalize">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <!-- "Choose install location" wizard page (needs WixUIExtension). -->
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER"/>
        <UIRef Id="WixUI_InstallDir"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
    </Product>
</Wix>
